[
  {
    "Name": "cortex-pendo-snapshot-refresh",
    "Description": "Shared Pendo ingest (preload 7/14/30/60/90 + Drive portfolio 90d) \u2014 daily 03:00 UTC",
    "ScheduleExpression": "cron(0 3 * * ? *)",
    "State": "ENABLED",
    "Targets": [
      {
        "Id": "cortex-pendo-snapshot-refresh",
        "Arn": "arn:aws:ecs:REGION:ACCOUNT_ID:cluster/cortex",
        "RoleArn": "arn:aws:iam::ACCOUNT_ID:role/cortex-eventbridge-ecs",
        "EcsParameters": {
          "TaskDefinitionArn": "arn:aws:ecs:REGION:ACCOUNT_ID:task-definition/cortex-decks",
          "LaunchType": "FARGATE",
          "PlatformVersion": "LATEST",
          "NetworkConfiguration": {
            "awsvpcConfiguration": {
              "Subnets": [
                "subnet-REPLACE"
              ],
              "SecurityGroups": [
                "sg-REPLACE"
              ],
              "AssignPublicIp": "DISABLED"
            }
          },
          "TaskCount": 1
        },
        "Input": "{\"containerOverrides\":[{\"name\":\"cortex-decks\",\"command\":[\"pendo-snapshot-refresh\"]}]}"
      }
    ]
  },
