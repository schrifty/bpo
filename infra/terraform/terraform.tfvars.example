# Copy to terraform.tfvars and adjust. Do NOT commit terraform.tfvars (gitignored).

aws_region   = "us-east-2"
name_prefix  = "cortex"
environment  = "prod"

# Default VPC + all its subnets (assign_public_ip=true for internet without NAT)
use_default_vpc  = true
assign_public_ip = true

# Upload split secrets from local builder (repo root):
#   python3 scripts/build_secrets_manager_json.py
# secrets_json_dir  = "../../output/cortex-secrets"
# secrets_json_file = "../../output/cortex-secrets-manager.json"  # optional combined → integrations

image_tag           = "latest"
default_job_command = ["engineering-portfolio"]

# Set true after first successful manual run-task
enable_schedules = false

# Morning-report SES: identity ARN (not *). Optional From pin:
# ses_identity     = "leandna.com"
# ses_from_address = "metrics@leandna.com"

# Optional KPI SQLite S3 object (injects CORTEX_KPI_STORE_S3_URI + IAM):
# kpi_store_s3_uri = "s3://your-bucket/kpi/observations.sqlite"

# task_cpu    = 4096
# task_memory = 16384
