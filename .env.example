# Copy to .env. Do not commit .env. Optional defaults: src/config.py.
# Unset CORTEX_* still accepts legacy BPO_* names.

# Logging
# LOG_LEVEL=INFO
# CORTEX_LOG_FORMAT=json

# Cache — Fernet required to write (.cache/ or EFS)
# CORTEX_CACHE_DIR=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Also in cortex/prod/integrations. No key = skip cache writes.
# CORTEX_CACHE_FERNET_KEY=
# CORTEX_INTEGRATION_DRIVE_CACHE_DISABLED=true
# CORTEX_INTEGRATION_DRIVE_CACHE_FORCE_REFRESH=true

# LLM — gemini | openai | anthropic (auto if unset)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# CORTEX_ENG_PORTFOLIO_LLM_SLIDES=true
# CORTEX_ENG_PORTFOLIO_LLM_MODEL=claude-opus-5
# CORTEX_ENG_PORTFOLIO_LLM_ALLOW_FALLBACK=false
# CORTEX_METRICS_LLM_SLIDES=true
# Slack / §7 LLM export. Do not set on the shared Fargate task.
# CORTEX_ALLOW_PRODUCTION_LLM_EXPORT=true

# Google — Drive, Slides, QBR
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_OWNER_EMAIL=you@example.com
GOOGLE_QBR_GENERATOR_FOLDER_ID=
# GOOGLE_QBR_OUTPUT_PARENT_ID=

# CORTEX_DUAL_WRITE_OUTPUT=true
# CORTEX_DRIVE_EXPORTS_FOLDER_ID=
# CORTEX_DRIVE_EXPORTS_CUSTOMER_FOLDER_ID=
# CORTEX_DRIVE_EXPORTS_HISTORY_FOLDER_ID=
# CORTEX_DRIVE_DECKS_FOLDER_ID=
# CORTEX_DRIVE_SYS_FOLDER_ID=
# CORTEX_DRIVE_SYS_CACHE_FOLDER_ID=
# CORTEX_DRIVE_SYS_CHART_DATA_FOLDER_ID=
# CORTEX_PORTFOLIO_SNAPSHOT_FOLDER_ID=
# CORTEX_PORTFOLIO_SNAPSHOT_CALENDAR_TZ=America/New_York
# CORTEX_PORTFOLIO_CUSTOMER_SOURCE=auto

# Pendo
PENDO_INTEGRATION_KEY=
# PENDO_BASE_URL=https://app.pendo.io/api/v1
# CORTEX_PORTFOLIO_EXCLUDE_CUSTOMERS=Automated
# CORTEX_PORTFOLIO_PARALLEL_WORKERS=8
CORTEX_FEATURE_ADOPTION_INSIGHTS=true
CORTEX_SIGNALS_LLM=true
CORTEX_SIGNALS_LLM_MAX_ITEMS=12
CORTEX_SIGNALS_LLM_EDITORIAL=true
CORTEX_SIGNALS_LLM_MANIFEST_MAX_CHARS=8000
CORTEX_SIGNALS_LLM_SLIDE_PROMPT_MAX_CHARS=2500
CORTEX_SIGNALS_TRENDS=true
CORTEX_SIGNALS_TRENDS_PRIOR_PERIOD=true
CORTEX_SIGNALS_TRENDS_WOW=true
CORTEX_SIGNALS_TRENDS_MOM=false
CORTEX_SIGNALS_TRENDS_YOY=false
CORTEX_SIGNALS_TRENDS_TIMEOUT=75

# Cursor
CURSOR_ADMIN_API_KEY=
# CORTEX_CURSOR_CACHE_TTL_HOURS=1
# CORTEX_CURSOR_USAGE_EVENTS_CACHE_TTL_HOURS=23
# CORTEX_CURSOR_CACHE_DISABLED=true

# GitHub
GITHUB_TOKEN=
GITHUB_ORG=leandna-apex
# GITHUB_REPOS=
# CORTEX_GITHUB_LOOKBACK_DAYS=30

# Jira / Atlassian
JIRA_URL=https://leandna.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
ATLASSIAN_ORG_ID=
# JIRA_ORGANIZATION=
# ATLASSIAN_API_KEY=
# JIRA_AUTH_MODE=site
# JIRA_CLOUD_ID=
# JIRA_CLOUD_ID_AUTO=true
# CORTEX_JIRA_PARALLEL_WORKERS=3
# CORTEX_JSM_ORG_CACHE_TTL_S=900
# CORTEX_HELP_JIRA_BODY_MAX=750
# CORTEX_HELP_JIRA_METRICS_MAX=2000
# CORTEX_JIRA_SKIP_JSM_ORG_FUZZY=true
# CORTEX_CYCLE_TIME_EXCLUDE_ISSUE_TYPES=Epic,Hypercare
# CORTEX_CYCLE_TIME_OUTLIER_SIGMA=4

# Salesforce (JWT)
SF_LOGIN_URL=https://login.salesforce.com
SF_CONSUMER_KEY=
SF_USERNAME=integration@example.com
SF_PRIVATE_KEY_PATH=salesforce_jwt.key
# SF_PRIVATE_KEY=
# SF_ACCOUNT_ULTIMATE_PARENT_LOOKUP=
# SF_ACCOUNT_FACTORY_START_DATE_FIELD=
# CORTEX_SALESFORCE_CACHE_TTL_HOURS=48
# CORTEX_SALESFORCE_CACHE_DISABLED=true

# LeanDNA — docs/SETUP/LEANDNA_SETUP.md
# EXECUTION_ENV=Production | Staging | unset
# Writes blocked in Production/CI unless CORTEX_ALLOW_PRODUCTION_MUTATIONS=true. Do not set on Fargate.
# EXECUTION_ENV=Production
# CORTEX_ALLOW_PRODUCTION_MUTATIONS=true
ST_LEANDNA_DATA_API_BASE_URL=https://app.staging.leandna.com/api
ST_LEANDNA_DATA_API_BEARER_TOKEN=
ST_LEANDNA_DATA_API_API_KEY=
PR_LEANDNA_DATA_API_BASE_URL=https://app.leandna.com/api
PR_LEANDNA_DATA_API_API_KEY=
# PR_LEANDNA_DATA_API_BEARER_TOKEN=
# LEANDNA_DATA_API_BASE_URL=https://app.leandna.com/api
# LEANDNA_DATA_API_API_KEY=
# LEANDNA_DATA_API_BEARER_TOKEN=
# LEANDNA_ITEM_MASTER_CACHE_TTL_HOURS=24
# LEANDNA_SHORTAGE_CACHE_TTL_HOURS=12
# LEANDNA_LEAN_PROJECTS_CACHE_TTL_HOURS=24
# LEANDNA_SITES_ACME_CORP=101,202

# Slack
SLACK_BOT_TOKEN=

# Finance / KPI digest
# Monthly opex USD excluding AI tooling. CORTEX_SUPPORT_FTE is headcount.
CORTEX_MONTHLY_SPEND_USD_ENGINEERING=436000
CORTEX_MONTHLY_SPEND_USD_SUPPORT=10478
CORTEX_SUPPORT_FTE=1
CORTEX_METRICS_DIGEST_TO=you@example.com
CORTEX_METRICS_DIGEST_FROM=you@example.com
# Morning-report EventBridge stays DISABLED until SES DKIM — see docs/SETUP/KPI_OPS.md
# Ship checklist: docs/SETUP/KPI_RELEASE.md (SES gate called out explicitly)
# Optional S3 sync for KPI SQLite (EFS is enough for ECS-only). Terraform: kpi_store_s3_uri.
# CORTEX_KPI_STORE_S3_URI=s3://bucket/kpi/observations.sqlite
# CLI actor for ownership (default: catalog_admin from config/kpi_owners.yaml)
# CORTEX_KPI_ACTOR=marc.schriftman@leandna.com

# KPI web (docs/SETUP/KPI_WEB.md) — Google Workspace SSO; release: KPI_RELEASE.md
# CORTEX_KPI_WEB_BASE_URL=http://127.0.0.1:8080
# CORTEX_KPI_WEB_HOST=127.0.0.1
# CORTEX_KPI_WEB_PORT=8080
# CORTEX_KPI_WEB_GOOGLE_CLIENT_ID=
# CORTEX_KPI_WEB_GOOGLE_CLIENT_SECRET=
# CORTEX_KPI_WEB_SESSION_SECRET=
# CORTEX_KPI_WEB_ALLOWED_DOMAINS=leandna.com
# CORTEX_KPI_WEB_COOKIE_SECURE=true
# CORTEX_KPI_WEB_SESSION_TTL_SECONDS=86400
# Local only (never production): bypass Google with /auth/dev-login
# CORTEX_KPI_WEB_ALLOW_DEV_AUTH=true
# CORTEX_KPI_WEB_DEV_USER=marc.schriftman@leandna.com
# CORTEX_KPI_WEB_SKIP_S3=true
# CORTEX_KPI_WEB_REGISTRY=   # optional alternate my-metrics path (tests/dev)
# CORTEX_KPI_WEB_OWNERS=     # optional alternate kpi_owners path (tests/dev)

# Slides write pacing
# CORTEX_SLIDES_WRITE_INTERVAL_SEC=1.05
# CORTEX_SLIDES_BATCH_UPDATE_RETRIES=12
# CORTEX_SLIDES_BATCH_CHUNK_SIZE=2000
