#!/usr/bin/env bash
# Columnar KPI digest report (stdout only; no email). Same as metrics-report.
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

if [[ "${1:-}" == "--install" ]]; then
  DEST="${HOME}/.local/bin/metrics-digest-columns"
  mkdir -p "${HOME}/.local/bin"
  ln -sf "${ROOT}/bin/metrics-digest-columns" "$DEST"
  echo "Installed: $DEST -> ${ROOT}/bin/metrics-digest-columns"
  case ":${PATH}:" in
    *":${HOME}/.local/bin:"*) ;;
    *)
      echo "Add to ~/.zshrc: export PATH=\"\${HOME}/.local/bin:\${PATH}\""
      ;;
  esac
  exit 0
fi

exec python3 "$ROOT/scripts/metrics-digest.py" --dry-run "$@"
